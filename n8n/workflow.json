        "jsCode": "const notas = [\n  {\n    nota: \"NF001\",\n    fornecedor: \"Fornecedor A\",\n    valor_nota: 1000,\n    valor_pago: 1000,\n    email_pagador: \"pagador1@example.com\"\n  },\n  {\n    nota: \"NF004\",\n    fornecedor: \"Fornecedor D\",\n    valor_nota: 500,\n    valor_pago: 650,\n    email_pagador: \"pagador4@example.com\"\n  }\n];\n\nreturn notas.map(nota => ({\n  json: {\n    ...nota,\n    excedente: Math.max(nota.valor_pago - nota.valor_nota, 0),\n    status: nota.valor_pago > nota.valor_nota\n      ? \"PAGAMENTO_EXCEDENTE\"\n      : nota.valor_pago === nota.valor_nota\n        ? \"PAGO_INTEGRALMENTE\"\n        : \"OUTRO_STATUS\"\n  }\n}));"
