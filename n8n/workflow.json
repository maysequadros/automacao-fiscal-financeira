      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const nota = item.json;\n\n  const valorNota = Number(nota.valor_nota ?? 0);\n  const valorPago = Number(nota.valor_pago ?? 0);\n\n  let status;\n\n  if (valorPago === 0) {\n    status = \"SEM_PAGAMENTO\";\n  } else if (valorPago < valorNota) {\n    status = \"PAGAMENTO_PARCIAL\";\n  } else if (valorPago === valorNota) {\n    status = \"PAGO_INTEGRALMENTE\";\n  } else {\n    status = \"PAGAMENTO_EXCEDENTE\";\n  }\n\n  return {\n    json: {\n      ...nota,\n      status,\n      saldo_pendente: Math.max(valorNota - valorPago, 0),\n      excedente: Math.max(valorPago - valorNota, 0)\n    }\n  };\n});\n"
      },
